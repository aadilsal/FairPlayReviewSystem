import os
import cv2
from ultralytics import YOLO


class YOLOBallDetector:
    """Wrapper around an Ultralytics YOLO model for cricket-ball detection.

    The class supports loading/reloading custom weights so you can fine-tune
    a model and point the running pipeline at the new weights without editing
    other modules.
    """
    def __init__(self, model_path='outputs/yolov8_cricket_ball2/weights/best.pt'):
        self.model = None
        self.model_path = None
        # Try to load the provided path; if missing, fall back to a small default
        self.load_weights(model_path)

    def load_weights(self, model_path):
        """Load YOLO weights from a path. If path doesn't exist, try to load
        a yolov8n fallback (bundled) so detection still works.
        """
        if model_path and os.path.exists(model_path):
            self.model = YOLO(model_path)
            self.model_path = model_path
            print(f"[INFO] Loaded YOLO weights from: {model_path}")
            return True

        # Fallbacks
        fallback = 'yolov8n.pt'
        try:
            self.model = YOLO(fallback)
            self.model_path = fallback
            print(f"[WARN] Requested weights not found. Loaded fallback: {fallback}")
            return True
        except Exception as e:
            print(f"[ERROR] Could not load YOLO model: {e}")
            self.model = None
            return False

    def detect(self, img):
        """Run detection on an image and return list of (x,y,w,h,conf).

        Only returns detections for class 0 (assumes your custom dataset maps
        cricket ball to class 0). If the model is not loaded, returns [].
        """
        detections = []
        if self.model is None:
            return detections

        results = self.model(img)
        for result in results:
            boxes = getattr(result, 'boxes', None)
            if boxes is not None:
                for box in boxes:
                    try:
                        cls_id = int(box.cls[0]) if hasattr(box.cls, '__len__') else int(box.cls)
                    except Exception:
                        # fallback if cls can't be read
                        cls_id = None
                    try:
                        confidence = float(box.conf)
                    except Exception:
                        confidence = 0.0
                    # box.xyxy is a tensor-like object
                    try:
                        coords = box.xyxy[0].cpu().numpy()
                        x1, y1, x2, y2 = coords
                        x, y, w, h = int(x1), int(y1), int(x2 - x1), int(y2 - y1)
                    except Exception:
                        continue
                    # Return class id too so callers can decide which class to use
                    detections.append((x, y, w, h, confidence, cls_id))
        return detections
