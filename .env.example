# DagsHub & MLflow
DAGSHUB_USERNAME=your-username
DAGSHUB_PAT=your-token
MLFLOW_TRACKING_URI=https://dagshub.com/your-username/your-repo.mlflow
MLFLOW_TRACKING_USERNAME=your-username
MLFLOW_TRACKING_PASSWORD=your-token

# Model Configuration
MLFLOW_MODEL_NAME=your-model-name
MODEL_VERSION=production

# Paths
UPLOAD_DIR=./mlops/data/uploads
RESULTS_DIR=./mlops/data/results
MAX_VIDEO_SIZE=500  # MB

# Inference Settings
DEVICE=cpu  # or cuda if GPU available

# Backend URL for frontend (optional)
BACKEND_URL=http://localhost:8000
